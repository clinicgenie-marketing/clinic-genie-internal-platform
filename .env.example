# Clinic Genie environment variable names. Copy to .env and fill locally. Never commit real values.

# --- Database (PostgreSQL) ---
# Admin connection used by migrations, seeds, backups and restore tests.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54339/clinic_genie
# Application connection used by the apps. Role cg_app has row-level security applied.
DATABASE_URL=postgresql://cg_app:cg_app_dev@127.0.0.1:54339/clinic_genie
# Password set on the cg_app role when migrations run. Change for staging/production.
APP_DB_PASSWORD=cg_app_dev
# Embedded development database settings (npm run db:start).
EMBEDDED_PG_PORT=54339
EMBEDDED_PG_DIR=.data/postgres
# Refuses seeds and restore tests unless the target database name contains this marker.
SEED_ALLOWED_DB_PATTERN=clinic_genie

# --- Clinic Genie platform (apps/platform) ---
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3400
# Development magic links are recorded in the database and shown at /dev/magic-links. Never enable in production.
AUTH_DEV_MAGIC_LINKS=true
# Google Workspace OAuth (managed identity). Leave empty until an OAuth client is approved.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Development only: the first Google sign-in from this Workspace domain becomes an admin.
AUTH_GOOGLE_HD=
# Shown in the header so staff know which environment they are in.
APP_ENVIRONMENT_LABEL=development
# Private evidence uploads directory for local development. Use object storage in production.
UPLOADS_DIR=.data/uploads
# Read-only connection to the clinic website database. Submitted forms are read from there and are not copied into this platform. Leave empty until that database is available.
ENQUIRY_DATABASE_URL=
